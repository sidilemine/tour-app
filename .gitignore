# macOS and editor-local files
.DS_Store
._*
.idea/
*.swp
*.swo
*~

# JavaScript dependencies and generated output (keep package-lock.json)
node_modules/
.expo/
expo-env.d.ts
.metro-cache/
.cache/
.toolchain/
*.tsbuildinfo
coverage/
dist/
web-build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Expo CNG: native output is regenerated from committed config/plugins.
# Owned native modules/config plugins outside these roots remain tracked.
/android/
/ios/
.gradle/
local.properties
*.apk
*.aab
*.ipa
*.hprof

# Credentials and signing material; examples must contain placeholders only.
.env
.env.*
!.env.example
!.env.*.example
credentials.json
*.keystore
*.jks
*.p8
*.p12
*.pem
*.mobileprovision
google-services.json
GoogleService-Info.plist

# Private run data and downloads; curated/sanitized fixtures remain tracked.
/diagnostics/
/local-data/
/downloads/
/artifacts/
*.log

# Do not blanket-ignore JSON, audio, maps, lockfiles or fixtures:
# small owned tour assets and approved replay data belong in version control.

# Python authoring-tool bytecode
__pycache__/
*.pyc
