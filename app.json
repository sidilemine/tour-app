{
  "expo": {
    "name": "Walking Tour Lab",
    "slug": "walking-tour-lab",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "uk.sidi.walkingtourlab",
      "versionCode": 1,
      "permissions": ["POST_NOTIFICATIONS", "RECEIVE_BOOT_COMPLETED"]
    },
    "plugins": [
      ["expo-location", {"isAndroidBackgroundLocationEnabled": true, "isAndroidForegroundServiceEnabled": true}],
      ["expo-audio", {"enableBackgroundPlayback": true, "enableBackgroundRecording": false, "recordAudioAndroid": true, "microphonePermission": "Record a private story review only when you choose Record."}],
      "expo-sqlite",
      "@maplibre/maplibre-react-native",
      ["expo-build-properties", {"android": {"buildArchs": ["arm64-v8a"]}}]
    ]
  }
}
